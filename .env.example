# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_tech_consultant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tech_consultant

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data

# ─── Task 1 service ──────────────────────────────────────────────────────────
TASK1_API_URL=http://localhost:8001
TASK1_API_KEY=dev-secret-task1

# ─── Task 2 service ──────────────────────────────────────────────────────────
TASK2_PORT=8002

# ─── Task 3 service ──────────────────────────────────────────────────────────
TASK3_PORT=8003

# ─── Scraper tuning ──────────────────────────────────────────────────────────
SCRAPE_DELAY_SECONDS=1.5
SCRAPE_BATCH_SIZE=5
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml

# ─── Model selection ─────────────────────────────────────────────────────────
MODEL_FAST=claude-haiku-4-5
MODEL_BALANCED=claude-sonnet-4-5
MODEL_BEST=claude-opus-4-5
